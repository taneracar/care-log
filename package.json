{
  "name": "care-log",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-network": "~58.0.5",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.10",
    "@types/react": "~19.3.0",
    "fast-check": "^4.11.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "test-renderer": "^1.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.2"
  },
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "server": "tsx server/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:core && npm run test:ui",
    "test:core": "vitest run",
    "test:ui": "jest",
    "test:e2e": "playwright test"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/ui/*.test.tsx"
    ]
  },
  "license": "MIT",
  "description": "Offline-first baby care log for two caregivers: Expo, SQLite outbox, field-level merge with visible conflicts"
}
